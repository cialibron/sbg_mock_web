{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TalkSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "speakerName",
    "email",
    "title",
    "services",
    "shortDescription",
    "details",
    "proposedStart",
    "timezone",
    "participants",
    "creditsRequested",
    "codeOfConduct",
    "captchaToken",
    "formStartedAt"
  ],
  "properties": {
    "speakerName": { "type": "string", "minLength": 2, "maxLength": 100 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "bio": { "type": "string", "maxLength": 1000 },
    "links": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 300, "pattern": "^https?://[^\\s]+$" }
    },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[A-Za-z0-9 .&()/+-]+$" }
    },
    "shortDescription": { "type": "string", "minLength": 10, "maxLength": 300 },
    "details": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "proposedStart": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$" },
    "participants": { "type": "integer", "minimum": 5, "maximum": 500 },
    "creditsRequested": { "type": "boolean" },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["costEstimateUsd", "durationHours", "justification"],
      "properties": {
        "costEstimateUsd": { "type": "number", "minimum": 0, "maximum": 500 },
        "durationHours": { "type": "number", "minimum": 0.5, "maximum": 24 },
        "justification": { "type": "string", "minLength": 10, "maxLength": 500 }
      }
    },
    "codeOfConduct": { "const": true },
    "captchaToken": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "website": { "type": "string", "maxLength": 200 },
    "formStartedAt": { "type": "integer", "minimum": 0 }
  },
  "if": {
    "properties": { "creditsRequested": { "const": true } },
    "required": ["creditsRequested"]
  },
  "then": { "required": ["credits"] }
}